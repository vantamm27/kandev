# Copy to fleetd.env (mode 0600) and fill in. See ../README.md for every key.
FLEET_KANDEV_URL=http://host.docker.internal:38429
# Required: a personal access token (kandev_pat_...) of the fleet service user,
# created under Settings > Account > API Tokens. fleetd refuses to start without it.
FLEET_KANDEV_TOKEN=
# Kandev runs in Docker, so its SSH key to the seats is a file inside the
# Kandev container (mounted under /data).
FLEET_SSH_IDENTITY_SOURCE=file
FLEET_SSH_IDENTITY_FILE=/data/home/.ssh/kandev_worker
FLEET_ADMIN_TOKEN=
FLEET_METRICS_TOKEN=
# Leave both empty to run registry and heartbeats without the dispatcher.
FLEET_WORKSPACE_ID=
FLEET_INTAKE_STEP_ID=
