# fleetd container image. Build from the repository root:
#   docker build -f apps/fleet/deploy/Dockerfile.fleetd -t fleetd:local .

FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY apps/fleet/go.mod apps/fleet/go.sum ./
RUN go mod download
COPY apps/fleet/cmd/ cmd/
COPY apps/fleet/internal/ internal/
RUN go build -trimpath -buildvcs=false -ldflags "-s -w" -o /out/fleetd ./cmd/fleetd

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -r fleet && useradd -r -g fleet -u 1001 -d /data -M fleet && \
    install -d -o fleet -g fleet /data
COPY --from=build /out/fleetd /usr/local/bin/fleetd
USER fleet
ENV FLEET_DB_PATH=/data/fleet.db \
    FLEET_LISTEN_ADDR=:8484
VOLUME ["/data"]
EXPOSE 8484
ENTRYPOINT ["tini", "--", "fleetd"]
CMD ["serve"]
